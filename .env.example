# services/api
GCP_PROJECT=
GCP_REGION=us-central1
# Agent Platform (formerly Vertex AI) model endpoint; can differ from the deployment region; blank inherits GCP_REGION.
VERTEX_LOCATION=
MODEL_FAST=
MODEL_PRO=
# Hourly model-call limits (each chat uses several calls).
MODEL_CALLS_PER_MEMBER_PER_HOUR=120
MODEL_CALLS_PER_WORKSPACE_PER_HOUR=400
# Set to 1 during a live demo to lift every usage limit (model calls, chats, voice minutes, sign-ups).
DEMO_UNLIMITED=0
MODEL_TIMEOUT_MS=60000
# Optional day-view link; starting a meeting always creates a new Meet space.
MEET_URL=
# Local demo only: wait for the separate Alter Chrome profile to join before opening Meet.
ALTER_MEET_BOT_URL=
# Hosted demo: use the private Firestore queue and a persistent cloud participant worker.
ALTER_MEET_BOT_MODE=
DEV_MODE=1
# Local mode explicitly uses SQLite + deterministic AI + simulated Google adapters.
# Production MUST use DEV_MODE=0 and the live backends.
STORE_BACKEND=sqlite
DATABASE_PATH=/tmp/alter.sqlite3
AI_BACKEND=local
GOOGLE_BACKEND=local
SERVICE_URL=http://127.0.0.1:8080
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Resource names ending in /versions/latest; never put secret values here.
A2A_HMAC_SECRET_NAME=
GOOGLE_OAUTH_SECRET_NAME=
DIRECTOR_KEY_SECRET_NAME=
GOOGLE_TEMPLATE_IDS={}
SEARCH_SERVING_CONFIG=
WORKFLOW_QUEUE=
WORKFLOW_SERVICE_ACCOUNT=
# Native-audio Vertex model and its supported region. The relay uses server ADC.
LIVE_MODEL=
LIVE_LOCATION=
SCHEDULER_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=
ADMIN_EMAIL=
WELCOME_DELAY_SECONDS=20
TRACE_DELAY_SECONDS=0.3
# Keep off unless a trusted proxy overwrites X-Real-IP.
TRUST_FORWARDED_IP=0

# apps/web (Vite)
VITE_API_BASE=http://localhost:8080/v1
VITE_MOCK=1

# Firebase web app configuration (public config, not a server credential).
# Supply apiKey, projectId, appId, authDomain and messagingSenderId for push.
VITE_FIREBASE_CONFIG=
VITE_FIREBASE_VAPID_KEY=
# Explicit opt-in for the local backend only. Never deploy it.
VITE_DEV_AUTH=0
# Set to api when local workspaces use SQLite but sign-in uses real Firebase.
VITE_UPDATES_SOURCE=
# Leave blank for the Vertex Live relay in the API (no Gemini API key required).
# Set only to explicitly use the legacy Developer API token service.
VITE_LIVE_TOKEN_BASE=
# Optional local emulators, e.g. 127.0.0.1:9099 and 127.0.0.1:8085
VITE_AUTH_EMULATOR_HOST=
VITE_FIRESTORE_EMULATOR_HOST=

# services/live-token: service-account ADC with Firestore access and access to this secret.
# Server reads the Gemini key from Secret Manager; never place it in VITE_*.
GEMINI_API_KEY_SECRET=
# The legacy token service also uses LIVE_MODEL; verify compatibility separately.
CORS_ORIGINS=
LIVE_WORKSPACE_MINUTES_PER_HOUR=40
