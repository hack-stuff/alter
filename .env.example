# services/api
GCP_PROJECT=
GCP_REGION=us-central1
# Vertex endpoint can differ from the deployment region; blank inherits GCP_REGION.
VERTEX_LOCATION=
MODEL_FAST=
MODEL_PRO=
DEV_MODE=1
# Local mode explicitly uses SQLite + deterministic AI + simulated Google adapters.
# Production MUST use DEV_MODE=0 and the live backends.
STORE_BACKEND=sqlite
DATABASE_PATH=/tmp/alter.sqlite3
AI_BACKEND=local
GOOGLE_BACKEND=local
SERVICE_URL=http://127.0.0.1:8080
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Resource names ending in /versions/latest; never put secret values here.
A2A_HMAC_SECRET_NAME=
GOOGLE_OAUTH_SECRET_NAME=
DIRECTOR_KEY_SECRET_NAME=
GOOGLE_TEMPLATE_IDS={}
SEARCH_SERVING_CONFIG=
SCHEDULER_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=
ADMIN_EMAIL=
WELCOME_DELAY_SECONDS=20
TRACE_DELAY_SECONDS=0.3
# Keep off unless a trusted proxy overwrites X-Real-IP.
TRUST_FORWARDED_IP=0

# apps/web (Vite)
VITE_API_BASE=http://localhost:8080/v1
VITE_MOCK=1

# Firebase web app configuration (public config, not a server credential).
# Supply one JSON object with apiKey, projectId, appId, authDomain.
VITE_FIREBASE_CONFIG=
# Explicit opt-in for the local backend only. Never deploy it.
VITE_DEV_AUTH=0
# Token endpoint can live in a separate Cloud Run service.
VITE_LIVE_TOKEN_BASE=
# Optional local emulators, e.g. 127.0.0.1:9099 and 127.0.0.1:8085
VITE_AUTH_EMULATOR_HOST=
VITE_FIRESTORE_EMULATOR_HOST=

# services/live-token: service-account ADC with Firestore access and access to this secret.
# Server reads the Gemini key from Secret Manager; never place it in VITE_*.
GEMINI_API_KEY_SECRET=
# Choose and verify an ephemeral-token-compatible native-audio model in your project.
LIVE_MODEL=
CORS_ORIGINS=
LIVE_WORKSPACE_MINUTES_PER_HOUR=40
